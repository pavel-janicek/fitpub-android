<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows plain HTTP for self-hosted FitPub instances (e.g. http://localhost:8080
  or a LAN address). This config governs cleartext on API 24+ (minSdk is 26),
  so no android:usesCleartextTraffic attribute is needed in the manifest.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>